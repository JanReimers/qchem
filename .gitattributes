# Line endings are NORMALIZED, so no editor or script can reintroduce the CRLF/LF mix.
# `text=auto` stores LF in the index no matter what bytes are on disk, so a tool that
# rewrites a file with the "wrong" endings produces NO diff instead of a whole-file one.
* text=auto

# Binary types marked explicitly rather than left to git's NUL-byte heuristic.
*.pdf  binary
*.ods  binary
*.xlsx binary
*.gz   binary
*.png  binary
*.jpg  binary

*.C linguist-language=C++
*.H linguist-language=C++
*.hpp linguist-language=C++
*.cpp linguist-language=C++

# The history records are APPEND-ONLY: two lanes that each append a closed item conflict on every
# merge (three times on 2026-11-12).  `union` keeps both sides' appended lines; it would only
# interleave text if two branches edited the SAME existing lines, which a history file never sees.
doc/Records/*History*.md merge=union
