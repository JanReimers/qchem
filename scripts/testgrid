#!/usr/bin/env python3
"""testgrid -- render the SCF test suite as the PRODUCT-SPACE GRID its names encode, and CHECK the names.

doc/TestSuitePlan.md §3: every solid-state SCF test is named
    <Basis>_<Material>.<k>[_<Grid>][_<Fit>][_<Sym>][_<Spin>][_<Occ>][_<Reservoir>][_<Machinery>...][_<Ansatz>][_<Seed>]_<Claim>
with the axis tokens in that FIXED ORDER, the facade's defaults elided (k always named), and the claim one of
CP2K (oracle anchor) | Anchor (did-E-move) | eq<Token> (a one-axis twin) | a property verb.  This script
parses those names, prints one row per test with every axis filled in (defaults included), and exits 1 on any
GPW_*/PW_* name that does not parse -- so the convention is a checked contract, not a habit.

Usage:
    scripts/testgrid [--exe build/Release/IntegrationTests/ITMain] [--check] [--cost build/Release/Testing/Temporary/CTestCostData.txt]
      (default: run the exe with --gtest_list_tests; --check prints nothing but the violations)
"""
import argparse, re, subprocess, sys, os

# ---- the vocabulary (doc/TestSuitePlan.md §1), in axis order.  A token appears under exactly one axis. ----
AXES = [
    ("k",        {"Γ":"Γ", "k211":"2x1x1", "k222":"2x2x2", "k222s":"2x2x2 shifted", "k311":"3x1x1"}, "Γ"),
    ("grid",     {"Uni":"uniform", "Becke":"Becke"},                                        "Auto"),
    ("fit",      {"PWFit":"PW fit", "DeltaFit":"delta fit"},                                "Auto"),
    ("sym",      {"Imp":"imposed", "Shub":"Shubnikov", "Grey":"grey (control)"},            "free"),
    ("spin",     {"Pol":"2-channel singlet", "M2":"doublet", "M3":"triplet", "M6":"sextet"},   "unpolarized"),
    ("occ",      {"Smear":"smeared", "Anneal":"annealed"},                                 "kT=0 aufbau"),
    ("reservoir",{"GlobalMu":"one μ over k", "ShFermi":"one μ over spin"},                   "per block/channel"),
    ("machinery",{"GDM":"GDM", "Ladder":"Ladder", "Kerker":"Kerker", "Pulay":"Pulay", "MOM":"MOM", "SeedMOM":"seed MOM", "Prototype":"prototype loop"}, "DIIS"),
    ("ansatz",   {"Cplx":"complex"},                                                        "real TRIM"),
    ("seed",     {"UniSeed":"uniform seed", "SpinSeed":"spin-SAD seed"},                    "IonicSAD"),
]
K_TOKENS   = set(AXES[0][1])
MULTI      = {"machinery"}                       # axes that may carry more than one token
CLAIM_RE   = re.compile(r"^(CP2K|Anchor|eq[A-Z]\w*|[A-Z]\w*)$")

def parse(suite, name):
    """-> (row dict, error or None)."""
    disabled = name.startswith("DISABLED_")
    if disabled: name = name[len("DISABLED_"):]
    m = re.match(r"^(GPW|PW|LAPW)_(\w+)$", suite)
    if not m: return None, f"suite '{suite}' is not <Basis>_<Material>"
    basis, material = m.groups()
    toks = name.split("_")
    if not toks or toks[0] not in K_TOKENS:
        return None, f"'{suite}.{name}': the first token must name k ({', '.join(K_TOKENS)}), got '{toks[0] if toks else ''}'"
    claim = toks[-1]
    if not CLAIM_RE.match(claim) or claim in K_TOKENS:
        return None, f"'{suite}.{name}': the last token '{claim}' is not a claim (CP2K | Anchor | eq<Token> | Verb)"
    row = {"basis": basis, "material": material, "disabled": disabled, "claim": claim}
    for ax, vocab, default in AXES: row[ax] = [] if ax in MULTI else None
    pos = 0                                       # the axis the previous token belonged to (order check)
    for t in toks[:-1]:
        hit = [i for i,(ax,vocab,_) in enumerate(AXES) if t in vocab]
        if not hit: return None, f"'{suite}.{name}': unknown token '{t}'"
        i = hit[0]; ax = AXES[i][0]
        if i < pos: return None, f"'{suite}.{name}': token '{t}' ({ax}) is out of axis order"
        if i == pos and ax not in MULTI and row[ax] is not None:
            return None, f"'{suite}.{name}': axis '{ax}' named twice"
        pos = i
        if ax in MULTI: row[ax].append(t)
        else: row[ax] = t
    for ax, vocab, default in AXES:
        v = row[ax]
        row[ax] = (", ".join(vocab[t] for t in v) if v else default) if ax in MULTI else (vocab[v] if v else default)
    return row, None

def kind(claim):
    if claim == "CP2K": return "oracle"
    if claim == "Anchor": return "anchor"
    if claim.startswith("eq"): return "twin =" + claim[2:]
    return "property: " + claim

def list_tests(exe):
    out = subprocess.run([exe, "--gtest_list_tests"], capture_output=True, text=True, check=True).stdout
    suite = None
    for line in out.splitlines():
        if not line.startswith(" "):
            suite = line.rstrip(".").strip()
        else:
            yield suite, line.strip().split(" ")[0]

def read_cost(path):
    cost = {}
    if path and os.path.exists(path):
        for line in open(path):
            parts = line.split()
            if len(parts) == 3:
                try: cost[parts[0]] = float(parts[2])
                except ValueError: pass
    return cost

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--exe", default="build/Release/IntegrationTests/ITMain")
    ap.add_argument("--cost", default="build/Release/Testing/Temporary/CTestCostData.txt")
    ap.add_argument("--check", action="store_true", help="print only the naming violations")
    a = ap.parse_args()
    cost = read_cost(a.cost)
    rows, errors = [], []
    for suite, name in list_tests(a.exe):
        if not re.match(r"^(GPW|PW|LAPW)_", suite): continue
        row, err = parse(suite, name)
        if err: errors.append(err); continue
        row["test"] = f"{suite}.{name}"
        row["s"] = cost.get(row["test"])
        rows.append(row)
    if not a.check:
        cols = ["test","k","grid","fit","sym","spin","occ","reservoir","machinery","ansatz","seed","claim"]
        head = ["TEST","k","grid","fit","symmetry","spin","occupation","reservoir","machinery","ansatz","seed","claim","s"]
        widths = [max(len(h), max((len(str(r[c])) for r in rows), default=0)) for h,c in zip(head,cols)]
        print("  ".join(h.ljust(w) for h,w in zip(head,widths)) + "  wall s")
        for r in sorted(rows, key=lambda r:(r["basis"], r["material"], r["test"])):
            cells = [str(r[c]) for c in cols]
            cells[0] = ("(off) " if r["disabled"] else "") + cells[0]
            cells[-1] = kind(r["claim"])
            print("  ".join(c.ljust(w) for c,w in zip(cells,widths)) + ("  %.1f" % r["s"] if r["s"] is not None else ""))
        n_on = sum(1 for r in rows if not r["disabled"])
        print(f"\n{len(rows)} grid tests ({n_on} enabled), {len(errors)} naming violation(s)")
    for e in errors: print("NAMING VIOLATION:", e, file=sys.stderr)
    return 1 if errors else 0

if __name__ == "__main__":
    sys.exit(main())
