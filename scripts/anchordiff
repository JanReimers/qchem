#!/usr/bin/env python3
"""Compare two ctest LastTest.log files test by test: the LAST printed total energy (Etot=, or 'Etot = ' from rundeck)
and the summed SCF iteration count (iters=).  Prints only the tests whose energy moved by more than --tol (Ha) or whose
iteration count changed, sorted by |dE|.  Usage: anchordiff.py BASE.log NEW.log [--tol 1e-9]"""
import re, sys

def parse(path):
    out = {}; name = None; E = None; iters = 0
    head = re.compile(r'^\d+/\d+ Testing: (.+)$')
    etot = re.compile(r'Etot\s*=\s*(-?\d+\.\d+)')
    it   = re.compile(r'iters=(\d+)')
    with open(path, encoding='utf-8', errors='replace') as f:
        for line in f:
            m = head.match(line.rstrip('\n'))
            if m:
                if name is not None: out[name] = (E, iters)
                name, E, iters = m.group(1).strip(), None, 0
                continue
            if name is None: continue
            for v in etot.findall(line): E = float(v)
            for v in it.findall(line): iters += int(v)
    if name is not None: out[name] = (E, iters)
    return out

def main():
    a = sys.argv[1:]
    tol = 1e-9
    if '--tol' in a: i = a.index('--tol'); tol = float(a[i+1]); del a[i:i+2]
    base, new = parse(a[0]), parse(a[1])
    rows = []
    for t in sorted(set(base) & set(new)):
        (Eb, ib), (En, i_n) = base[t], new[t]
        if Eb is None or En is None: dE = None
        else: dE = En - Eb
        if (dE is not None and abs(dE) > tol) or ib != i_n:
            rows.append((abs(dE) if dE is not None else -1, t, Eb, En, dE, ib, i_n))
    rows.sort(reverse=True)
    print(f"{len(rows)} tests moved (|dE|>{tol:g} Ha or iteration count changed) of {len(set(base)&set(new))} compared")
    for _, t, Eb, En, dE, ib, i_n in rows:
        es = f"{dE:+.3e}" if dE is not None else "   n/a   "
        print(f"  {es}  iters {ib:>4} -> {i_n:<4}  {t}")
    only = sorted(set(base) ^ set(new))
    if only: print("in one log only:", ", ".join(only[:20]))

main()
