    template <class T> EnergyBreakdown tHamiltonianAt<T>::GetTotalEnergy() const;
    using rStatic_HT = tStatic_HT<double>;
    using cStatic_HT = tStatic_HT<dcmplx>;
    using rDynamic_HT = tDynamic_HT<double>;
    using cDynamic_HT = tDynamic_HT<dcmplx>;
    using rDynamic_HF_HT= tDynamic_HF_HT<double>;
    using cDynamic_HF_HT= tDynamic_HF_HT<dcmplx>;
    using rHamiltonian = tHamiltonian<double>;
    using cHamiltonian = tHamiltonian<dcmplx>;
    using rHamiltonianAt = tHamiltonianAt<double>;
    using cHamiltonianAt = tHamiltonianAt<dcmplx>;
}

### qchem.WaveFunction   (src/WaveFunction/WaveFunction.C)
export import qchem.EnergyLevel;
export import qchem.Hamiltonian;
export import qchem.ChargeDensity;
export import qchem.Symmetry.Irrep;
export import qchem.Orbitals;
namespace qchem::WaveFunction {
    using qchem::ChargeDensity::rDM_CD;
    using qchem::ChargeDensity::tDM_CD;
    using qchem::Orbitals::EnergyLevels;
    template <class T> class tWaveFunction {
    public:
        typedef ScalarFunction<double> sf_t;
        typedef std::vector<Irrep> iqns_t;
        virtual ~tWaveFunction();
        virtual const Orbitals* GetOrbitals (const Irrep& ) const=0;
        virtual std::unique_ptr<tDM_CD<T>> GetChargeDensity() const=0;
        virtual EnergyLevels GetEnergyLevels () const=0;
        virtual iqns_t GetQNs () const=0;
        virtual void DisplayEigen () const=0;
        virtual SpinGroup GetSpinGroup () const=0;
        virtual std::unique_ptr<sf_t> GetSpinDensity() const=0;
    private:
        tWaveFunction& operator=(const tWaveFunction&);
    };
    using WaveFunction = tWaveFunction<double>;
    using cWaveFunction = tWaveFunction<dcmplx>;
}

### qchem.Fitting.FunctionFitter   (src/Fitting/FunctionFitter.C)
export import qchem.Mesh.Integrator;
export import qchem.ScalarFunction;
export import qchem.BasisSet.Orbital_DFT_IBS;
namespace qchem::Fitting {
    template <class T> class ProjectedDensity {
    public:
        virtual ~ProjectedDensity() = default;
    };
    class ProjectedDensity_AO : public virtual ProjectedDensity<double> {
    public:
        virtual double FitGetConstraint() const=0;
    };
    class DensityProjector {
    public:
        virtual ~DensityProjector() = default;
        virtual const qcMesh::MatrixForward<double>& Forward(const BasisSet::Orbital_DFT_IBS<double,double>&) const=0;
        virtual size_t NumCoefficients() const=0;
    };
    class CoulombMetric_ProjectedDensity : public virtual ProjectedDensity_AO {
    public:
        virtual rvec_t GetRepulsion3C(const DensityProjector&) const=0;
    };
    class OverlapMetric_ProjectedDensity : public virtual ProjectedDensity_AO {
    public:
        virtual rvec_t GetUnconstrainedFit(const BasisSet::rFIT_CD_ABS* fbs) const=0;
    };
    class ProjectedDensity_G : public virtual ProjectedDensity<dcmplx> {
    public:
        explicit ProjectedDensity_G(const ΔG_Map& rhoTilde);
        const ΔG_Map& Map() const;
    private:
        ΔG_Map itsMap;
    };
    class ProjectedScalar_R {
    public:
        virtual ~ProjectedScalar_R() = default;
        virtual const ScalarFunction<double>* GetScalarFunction() const=0;
    };
    class FieldProjector {
    public:
        virtual ~FieldProjector() = default;
        virtual rvec_t Project(const ScalarFunction<double>& f) const=0;
        virtual size_t NumCoefficients() const=0;
    };
    class ScalarProjector : public virtual FieldProjector {
    public:
        virtual const qcMesh::MatrixForward<double>& Forward(const BasisSet::Orbital_DFT_IBS<double,dcmplx>&) const=0;
        virtual const qcMesh::MatrixForward<dcmplx>& Forward(const BasisSet::Orbital_DFT_IBS<dcmplx,dcmplx>&) const=0;
    };
    class FunctionFitter_Scalar {
    public:
        virtual ~FunctionFitter_Scalar() = default;
        virtual void DoFit (const ProjectedScalar_R&) =0;
        virtual void ReScale (double factor) =0;
        virtual std::ostream& Write (std::ostream&) const =0;
    };
    template <class U, class TFit> class FitContraction {
    public:
        virtual ~FitContraction() = default;
        virtual hmat_t<U> Overlap(const BasisSet::Orbital_DFT_IBS<U,TFit>&) const=0;
    };
    template <class T> class ScalarFit : public virtual FunctionFitter_Scalar , public virtual FitContraction<T,T> {
    };
    template <class T> class DeltaScalarFit : public virtual ScalarFit<T> , public virtual FieldProjector {
    };
    template <> class DeltaScalarFit<dcmplx> : public virtual ScalarFit<dcmplx> , public virtual FitContraction<double,dcmplx> , public virtual ScalarProjector {
    };
    template <class T> class FunctionFitter_Density {
    public:
        virtual ~FunctionFitter_Density() = default;
        virtual void DoFit (const ProjectedDensity<T>&)=0;
        virtual hmat_t<T> Repulsion (const robs_t<T>*) const =0;
        virtual std::ostream& Write (std::ostream&) const =0;
    };
    template <class T> class FunctionFitter_Density_NonOrtho : public virtual FunctionFitter_Density<T> {
    public:
        virtual double FitGetSelfRepulsion() const=0;
        virtual double Integral () const=0;
        virtual void ReScale (double factor)=0;
    };
    template <class T> std::unique_ptr<ScalarFit<T>> Factory(std::shared_ptr<const BasisSet::FIT_SF_ABS<T>>&);
    template <class T> std::unique_ptr<DeltaScalarFit<T>> MakeDeltaScalarFitter(std::shared_ptr<const BasisSet::FIT_SF_ABS<T>>&);
    std::unique_ptr<FunctionFitter_Density_NonOrtho<double>> Factory(std::shared_ptr<const BasisSet::rFIT_CD_ABS>&);
    std::unique_ptr<FunctionFitter_Density<dcmplx>> Factory(std::shared_ptr<const BasisSet::cFIT_CD_ABS>&);
}

### qchem.Symmetry.Representation   (src/Symmetry/Representation.C)
export import qchem.Symmetry.SymOp;
export import qchem.Types;
namespace qchem::Symmetry {
    template <class T> class Representation {
    public:
        virtual ~Representation() = default;
        virtual mat_t<T> Image (const SymOp& g, const hmat_t<T>& O) const=0;
        virtual mat_t<T> AdjointImage(const SymOp& g, const hmat_t<T>& X) const=0;
        virtual void AddAdjointImage(const SymOp& g, const hmat_t<T>& X, mat_t<T>& acc) const;
    };
    inline bool SameSpatial(const SymOp& a, const SymOp& b);
    class Stabiliser {
    public:
        Stabiliser() = default;
        static Stabiliser OpList(std::shared_ptr<const std::vector<SymOp>> ops);
        static Stabiliser FixingPoint(const rvec3_t& centre);
        bool Contains(const SymOp& g) const;
    private:
        std::shared_ptr<const std::vector<SymOp>> itsOps;
        bool itsFixesPoint=false;
        rvec3_t itsCentre=rvec3_t(0,0,0);
    };
    template <class T> class IdentityRepresentation : public virtual Representation<T> {
    public:
        explicit IdentityRepresentation(Stabiliser s={});
        virtual mat_t<T> Image (const SymOp& g, const hmat_t<T>& O) const override;
        virtual mat_t<T> AdjointImage(const SymOp& g, const hmat_t<T>& X) const override;
    private:
        void Require(const SymOp& g) const;
        Stabiliser itsStabiliser;
    };
    template <class T> class DenseRepresentation : public virtual Representation<T> {
    public:
        virtual mat_t<T> Image (const SymOp& g, const hmat_t<T>& O) const override;
        virtual mat_t<T> AdjointImage(const SymOp& g, const hmat_t<T>& X) const override;
        virtual void AddAdjointImage(const SymOp& g, const hmat_t<T>& X, mat_t<T>& acc) const override;
    protected:
        virtual mat_t<T> MakeRepMatrix(const SymOp& g) const=0;
    private:
        struct Rep {
            bool isReal=false;
            rmat_t R;
            mat_t<T> M;
        };
        const Rep& GetRep(const SymOp& g) const;
        mutable std::vector<std::pair<SymOp, Rep>> itsCache;
    };
    class MonomialRepresentation : public virtual Representation<dcmplx> {
    public:
        struct Monomial {
            std::vector<size_t> perm;
            cvec_t phase;
        };
        virtual mat_t<dcmplx> Image (const SymOp& g, const hmat_t<dcmplx>& O) const override;
        virtual mat_t<dcmplx> AdjointImage(const SymOp& g, const hmat_t<dcmplx>& X) const override;
        virtual void AddAdjointImage(const SymOp& g, const hmat_t<dcmplx>& X, mat_t<dcmplx>& acc) const override;
    protected:
        virtual Monomial MakeMonomial(const SymOp& g) const=0;
    private:
        const Monomial& GetMonomial(const SymOp& g) const;
        mutable std::vector<std::pair<SymOp, Monomial>> itsCache;
    };
}

### qchem.Structure   (src/Structure/Structure.C)
namespace qchem {
    class Structure;
    struct Site {
        int Z;
        rvec3_t R = {0,0,0};
        double netCharge = 0.0;
        bool spinFlip = false;
    };
    class SiteRange {
    public:
        class iterator {
        public:
            using value_type = Site;
            using difference_type = std::ptrdiff_t;
            iterator() = default;
            const Site& operator* () const;
            iterator& operator++();
            iterator operator++(int);
            bool operator!=(const iterator& b) const;
            bool operator==(const iterator& b) const;
        private:
            friend class SiteRange;
            iterator(const Structure* s, size_t i);
            const Structure* itsS=nullptr;
            size_t itsI=0;
        };
        iterator begin() const;
        iterator end () const;
        size_t size () const;
        const Site& operator[](size_t i) const;
    private:
        friend class Structure;
        explicit SiteRange(const Structure& s);
        static const Site& At(const Structure* s, size_t i);
        const Structure* itsS;
    };
    class Structure : public virtual Streamable {
    public:
        virtual ~Structure();
        virtual std::shared_ptr<Structure> Clone() const=0;
        virtual std::string ID () const;
        virtual size_t GetNumAtoms () const=0;
        virtual int GetNuclearCharge () const;
        virtual double GetNumElectrons () const;
        virtual double GetNetCharge () const;
        virtual double IonIonEnergy (const std::function<double(int Z)>& zionOf) const;
        virtual double G0Background (const std::function<double(int Z)>& f) const;
        virtual bool HasTranslationSymmetry() const;
        SiteRange Sites() const;
        void ForEachSite(const std::function<void(int Z, const rvec3_t& R, bool spinFlip)>& f) const;
        virtual qcMesh::Mesh CreateIntegrationMesh(const qcMesh::MeshParams&) const=0;
        virtual size_t GetAtomIndex(const rvec3_t&, double tol=0.0) const;
        void MoveSites(const std::vector<rvec3_t>& R);
        void SetNetCharges(const std::function<double(int Z)>& netChargeOf);
    protected:
        friend class SiteRange;
        virtual const Site& GetSite(size_t i) const=0;
        virtual Site& GetSite(size_t i) =0;
    };
    class Atom : public Structure {
    public:
        Atom(int Z);
        Atom(int Z, double netCharge);
        Atom(int Z, const rvec3_t& R);
        Atom(int Z, double netCharge, const rvec3_t& R);
        explicit Atom(const Site& s);
        virtual std::shared_ptr<Structure> Clone() const override;
        virtual size_t GetNumAtoms () const override;
        virtual qcMesh::Mesh CreateIntegrationMesh(const qcMesh::MeshParams&) const override;
        virtual std::string ID () const override;
        virtual std::ostream& Write (std::ostream&) const override;
    protected:
        virtual const Site& GetSite(size_t) const override;
        virtual Site& GetSite(size_t) override;
    private:
        Site itsSite;
    };
    class Molecule : public virtual Structure {
    public:
        Molecule();
        Molecule(const Structure& m);
        virtual std::shared_ptr<Structure> Clone() const override;
        virtual void Insert (const Site& s);
        virtual size_t GetNumAtoms() const override;
        virtual qcMesh::Mesh CreateIntegrationMesh(const qcMesh::MeshParams&) const override;
        virtual std::ostream& Write(std::ostream&) const override;
    protected:
        virtual const Site& GetSite(size_t i) const override;
        virtual Site& GetSite(size_t i) override;
    private:
        std::vector<Site> itsSites;
    };
}

