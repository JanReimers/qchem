# The Mn SUBLATTICE of MnO AFM-II alone: mno_fm_gpw_va.inp with the O removed (same cell, VA Mn, both Mn seeded +5 alpha), moment FIXED at 10.
# The lattice-sum rung of the MnO operator localizer (OpenWork §3); qchem side: material MnO_AFM2_Mnsub.
&GLOBAL
  PROJECT mnsub_gpw_va
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME ./VALENCE-LOWQ-BASIS
    POTENTIAL_FILE_NAME /home/janr/Code/cp2k/data/GTH_POTENTIALS
    UKS
    MULTIPLICITY 11
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-12
    &END QS
    &MGRID
      CUTOFF 144
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &XC
      &XC_FUNCTIONAL
        &LDA_X
        &END LDA_X
        &LDA_C_VWN
        &END LDA_C_VWN
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      IGNORE_CONVERGENCE_FAILURE
      ADDED_MOS 20
      &DIAGONALIZATION T
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING T
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 1.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [au_temp] 5.0E-3
        FIXED_MAGNETIC_MOMENT 10.0
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      A [bohr] 8.40 4.20 4.20
      B [bohr] 4.20 8.40 4.20
      C [bohr] 4.20 4.20 8.40
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Mn1 0.00 0.00 0.00
      Mn2 0.50 0.50 0.50
    &END COORD
    &KIND Mn1
      ELEMENT Mn
      BASIS_SET VALENCE-LOWQ-VA
      POTENTIAL GTH-PADE-q7
      # +m sublattice: 5 unpaired d alpha (Hund d^5)
      &BS
        &ALPHA
          NEL  5
          L    2
          N    3
        &END ALPHA
        &BETA
          NEL -5
          L    2
          N    3
        &END BETA
      &END BS
    &END KIND
    &KIND Mn2
      ELEMENT Mn
      BASIS_SET VALENCE-LOWQ-VA
      POTENTIAL GTH-PADE-q7
      # FM: same +m seed as Mn1 (no flip)
      &BS
        &ALPHA
          NEL  5
          L    2
          N    3
        &END ALPHA
        &BETA
          NEL -5
          L    2
          N    3
        &END BETA
      &END BS
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
