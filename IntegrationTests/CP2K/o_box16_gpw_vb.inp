# O q6 TRIPLET pseudo-atom at the centre of a 16-bohr cubic box (VALENCE-LOWQ-VB O = our valence_lowq_va O block, GTH-PADE-q6,
# LDA_X+VWN5, Gamma, PERIODIC XYZ), moment FIXED at 2 so both codes hold the same state -- the O rung of the MnO operator localizer
# (OpenWork §3 "MnO accuracy -- name the operator"); qchem side: material O_box16.  Settings as mn_box16_gpw_va.inp.
&GLOBAL
  PROJECT o_box16_gpw_vb
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME ./VALENCE-LOWQ-BASIS
    POTENTIAL_FILE_NAME /home/janr/Code/cp2k/data/GTH_POTENTIALS
    UKS
    MULTIPLICITY 3
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-12
    &END QS
    &MGRID
      CUTOFF 144
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &XC
      &XC_FUNCTIONAL
        &LDA_X
        &END LDA_X
        &LDA_C_VWN
        &END LDA_C_VWN
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      IGNORE_CONVERGENCE_FAILURE
      ADDED_MOS 20
      &DIAGONALIZATION T
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING T
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 1.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [au_temp] 5.0E-3
        FIXED_MAGNETIC_MOMENT 2.0
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 16.0 16.0 16.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      O  0.50 0.50 0.50
    &END COORD
    &KIND O
      ELEMENT O
      BASIS_SET VALENCE-LOWQ-VB
      POTENTIAL GTH-PADE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
