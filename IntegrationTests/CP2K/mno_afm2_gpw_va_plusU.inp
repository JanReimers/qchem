# MnO rocksalt AFM-II, SHELL-AVERAGED DFT+U ORACLE (programme step 5.1, 2026-09-19): the banked
# mno_afm2_gpw_va.inp deck (-61.30332518 Ha, doc/Records/CP2Kresults.md) with ONE change -- a Dudarev
# U_MINUS_J = 4.0 eV on the Mn 3d shell of BOTH sublattice kinds, LOWDIN projectors.  Everything else
# (basis, PP, functional, cutoffs, EPS, mixing, smearing, cell, BS guess) is byte-identical to the
# anchor so the DELTA is the Hubbard term alone.  CP2K has only shell-averaged U (no orbital
# resolution), so this is what qchem's per-irrep vector with all U_i equal must reproduce.
# doc/OpenWork.md section 1 step 5.1; doc/Pins.md pin 23.
&GLOBAL
  PROJECT mno_afm2_gpw_va_plusU
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME ./VALENCE-LOWQ-BASIS
    POTENTIAL_FILE_NAME /home/janr/Code/cp2k/data/GTH_POTENTIALS
    UKS
    MULTIPLICITY 1
    PLUS_U_METHOD LOWDIN
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-12
    &END QS
    &MGRID
      CUTOFF 144
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &XC
      &XC_FUNCTIONAL
        &LDA_X
        &END LDA_X
        &LDA_C_VWN
        &END LDA_C_VWN
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &PLUS_U ON
      &END PLUS_U
    &END PRINT
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      IGNORE_CONVERGENCE_FAILURE
      ADDED_MOS 20
      &DIAGONALIZATION T
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING T
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 1.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [au_temp] 5.0E-3
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      A [bohr] 8.40 4.20 4.20
      B [bohr] 4.20 8.40 4.20
      C [bohr] 4.20 4.20 8.40
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Mn1 0.00 0.00 0.00
      Mn2 0.50 0.50 0.50
      O   0.25 0.25 0.25
      O   0.75 0.75 0.75
    &END COORD
    &KIND Mn1
      ELEMENT Mn
      BASIS_SET VALENCE-LOWQ-VA
      POTENTIAL GTH-PADE-q7
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 4.0
      &END DFT_PLUS_U
      # +m sublattice: 5 unpaired d alpha (Hund d^5)
      &BS
        &ALPHA
          NEL  5
          L    2
          N    3
        &END ALPHA
        &BETA
          NEL -5
          L    2
          N    3
        &END BETA
      &END BS
    &END KIND
    &KIND Mn2
      ELEMENT Mn
      BASIS_SET VALENCE-LOWQ-VA
      POTENTIAL GTH-PADE-q7
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 4.0
      &END DFT_PLUS_U
      # -m sublattice: the flip
      &BS
        &ALPHA
          NEL -5
          L    2
          N    3
        &END ALPHA
        &BETA
          NEL  5
          L    2
          N    3
        &END BETA
      &END BS
    &END KIND
    &KIND O
      BASIS_SET VALENCE-LOWQ-VB
      POTENTIAL GTH-PADE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
