 &control
    calculation  = 'scf'
    restart_mode = 'from_scratch',
    prefix       = 'lifeo2'
    pseudo_dir   = './'
    outdir       = './'
    tprnfor      = .true.
    tstress      = .true.
 /
 &system
    ibrav        = 5,
    celldm(1)    = 9.546896,
    celldm(4)    = 0.837156,
    nat          = 4,
    ntyp         = 3,
    ecutwfc      = 300.0, input_dft='sla+vwn',
    ecutrho      = 1200.0,
    occupations  = 'smearing',
    smearing     = 'cold',
    degauss      = 0.01,
    nspin        = 1,
 /
 &electrons
    conv_thr    = 1.d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
