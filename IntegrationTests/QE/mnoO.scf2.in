&control
  calculation='scf', prefix='mnoO', pseudo_dir='./', outdir='./tmp', verbosity='high'
/
&system
  ibrav=0, celldm(1)=8.40, nat=4, ntyp=3,
  ecutwfc=100.0, ecutrho=400.0,
  nbnd=17, occupations='fixed',
  nspin=2, tot_magnetization=0.0,
  input_dft='sla+vwn'
/
&electrons
  conv_thr=1.d-12, mixing_beta=0.3, startingpot='file', startingwfc='file'
/
ATOMIC_SPECIES
 Mn1 54.938 Mn.pz-gth-q7.UPF
 Mn2 54.938 Mn.pz-gth-q7.UPF
 O   15.999 O.pz-gth-q6.UPF
ATOMIC_POSITIONS {crystal}
 Mn1 0.00 0.00 0.00
 Mn2 0.50 0.50 0.50
 O   0.25 0.25 0.25
 O   0.75 0.75 0.75
CELL_PARAMETERS {alat}
 1.0 0.5 0.5
 0.5 1.0 0.5
 0.5 0.5 1.0
K_POINTS {automatic}
 2 2 2 0 0 0
HUBBARD {ortho-atomic}
U Mn1-3d 1.d-8
U Mn2-3d 1.d-8
