 &control
    calculation  = 'scf'
    restart_mode = 'from_scratch',
    prefix       = 'srvo3'
    pseudo_dir   = './'
    outdir       = './'
    tprnfor      = .true.
    tstress      = .true.
 /
 &system
    ibrav        = 0,
    celldm(1)    = 7.2605,
    nat          = 5,
    ntyp         = 3,
    ecutwfc      = 300.0, input_dft='sla+vwn',
    ecutrho      = 1200.0,
    occupations  = 'smearing',
    smearing     = 'gauss',
    degauss      = 0.02,
    nspin        = 1,
 /
 &electrons
    conv_thr    = 1.d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 V   50.942  V.pz-gth-q5.UPF
 Sr  87.620  Sr.pz-gth-q2.UPF
 O   16.000  O.pz-gth-q6.UPF
ATOMIC_POSITIONS {alat}
 V   0.0000000   0.0000000   0.0000000
 Sr  0.5000000   0.5000000   0.5000000
 O   0.5000000   0.0000000   0.0000000
 O   0.0000000   0.5000000   0.0000000
 O   0.0000000   0.0000000   0.5000000
CELL_PARAMETERS
 1.00000000  0.00000000  0.00000000
 0.00000000  1.00000000  0.00000000
 0.00000000  0.00000000  1.00000000
K_POINTS {automatic}
 4 4 4 0 0 0
HUBBARD {ortho-atomic}
U V-3d 1.d-8
