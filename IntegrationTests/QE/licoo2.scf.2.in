 &control
    calculation  = 'scf'
    restart_mode = 'from_scratch',
    prefix       = 'licoo2'
    pseudo_dir   = './'
    outdir       = './'
    tprnfor      = .true.
    tstress      = .true.
 /
 &system
    ibrav        = 5,
    celldm(1)    = 9.353622,
    celldm(4)    = 0.838532,
    nat          = 4,
    ntyp         = 3,
    ecutwfc      = 300.0, input_dft='sla+vwn',
    ecutrho      = 1200.0,
    nbnd         = 15
    occupations  = 'fixed'
    nspin        = 1,
 /
 &electrons
    conv_thr    = 1.d-15
    mixing_beta = 0.3
    startingpot = 'file'
    startingwfc = 'file'
    diago_david_ndim=4
 /
ATOMIC_SPECIES
 Co  58.933  Co.pz-gth-q9.UPF
 Li  6.941   Li.pz-gth-q1.UPF
 O   16.000  O.pz-gth-q6.UPF
ATOMIC_POSITIONS {crystal}
 Co  0.5000000   0.5000000   0.5000000
 Li  0.0000000   0.0000000   0.0000000
 O   0.2396000   0.2396000   0.2396000
 O   0.7604000   0.7604000   0.7604000
K_POINTS {automatic}
 4 4 4 0 0 0
HUBBARD {ortho-atomic}
U Co-3d 1.d-8
